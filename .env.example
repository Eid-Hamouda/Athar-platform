# Browser-safe Supabase configuration
# The Supabase publishable/anon key is designed for public clients.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only AI credentials
# Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional provider/model overrides used by services/fallbackProvider.ts
OPENROUTER_VISION_MODELS=
OPENROUTER_TEXT_MODELS=

GROQ_API_KEY=
GROQ_VISION_MODELS=
GROQ_TEXT_MODELS=

OPENAI_VISION_MODELS=
OPENAI_TEXT_MODELS=
